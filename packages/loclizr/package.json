{
  "name": "loclizr",
  "version": "0.1.2",
  "description": "Typed message functions and default-on catalog checks, generated from your translation files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasinmiran/loclizr.git",
    "directory": "packages/loclizr"
  },
  "homepage": "https://github.com/yasinmiran/loclizr#readme",
  "bugs": {
    "url": "https://github.com/yasinmiran/loclizr/issues"
  },
  "keywords": [
    "i18n",
    "icu",
    "messageformat",
    "typescript",
    "codegen",
    "react",
    "translations"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "loclizr": "./dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": ["./dist/react/index.d.ts"],
      "server": ["./dist/server/index.d.ts"],
      "compiler": ["./dist/compiler/index.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.19",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
