---
import { gridRows, languageName } from './language-demo'

const initialCount = 3
const presets = [0, 1, 2, 3, 5, 11, 22, 101, 1000000]
---

<div class="locale-grid not-content" data-locale-grid>
  <div class="controls">
    <label>
      Items
      <input name="count" type="number" min="0" step="1" value={initialCount} />
    </label>
    <div class="presets">
      {presets.map((preset) => <button type="button" data-count={preset}>{preset}</button>)}
    </div>
  </div>
  <div class="scroll">
    <table>
      <tbody>
        {
          gridRows(initialCount).map((row) => (
            <tr data-locale={row.locale} lang={row.locale} dir={row.locale === 'ar' ? 'rtl' : 'ltr'}>
              <th scope="row" lang="en" dir="ltr">{languageName(row.locale)}</th>
              <td>{row.items}</td>
              <td>{row.total}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<script>
  import { mountLocaleGrid } from './language-demo'

  for (const root of document.querySelectorAll<HTMLElement>('[data-locale-grid]')) mountLocaleGrid(root)
</script>

<style>
  .locale-grid {
    margin-block: 1.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem;
    padding: 1rem;
    border-block-end: 1px solid var(--sl-color-hairline);
  }
  label {
    display: grid;
    gap: 0.25rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  input,
  button {
    font: inherit;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    padding: 0.375rem 0.5rem;
  }
  input {
    width: 8rem;
  }
  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  button {
    cursor: pointer;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
  }
  button:hover {
    border-color: var(--sl-color-gray-3);
  }
  .scroll {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  th,
  td {
    padding: 0.5rem 1rem;
    text-align: start;
    border-block-end: 1px solid var(--sl-color-hairline);
    white-space: nowrap;
  }
  tr:last-child th,
  tr:last-child td {
    border-block-end: 0;
  }
  th {
    font-weight: 500;
    color: var(--sl-color-gray-3);
  }
</style>
