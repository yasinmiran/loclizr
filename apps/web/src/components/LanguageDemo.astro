---
import { demoLines, demoLocales, initialInput, languageName, orderStates } from './language-demo'

const lines = demoLines(initialInput)
---

<div class="language-demo not-content" data-language-demo>
  <div class="controls">
    <label>
      Language
      <select name="locale">
        {demoLocales.map((locale) => <option value={locale} selected={locale === initialInput.locale}>{languageName(locale)}</option>)}
      </select>
    </label>
    <label>
      Name
      <input name="name" value={initialInput.name} autocomplete="off" />
    </label>
    <label>
      Items
      <input name="count" type="number" min="0" step="1" value={initialInput.count} />
    </label>
    <label>
      Status
      <select name="state">
        {orderStates.map((state) => <option value={state} selected={state === initialInput.state}>{state}</option>)}
      </select>
    </label>
  </div>
  <div class="output" data-output lang={initialInput.locale} aria-live="polite">
    {lines.map((line) => <p>{line}</p>)}
  </div>
  <code class="call" data-call>m.demo_items(&#123; count: {initialInput.count} &#125;, &#123; locale: '{initialInput.locale}' &#125;)</code>
</div>

<script>
  import { mountLanguageDemo } from './language-demo'

  for (const root of document.querySelectorAll<HTMLElement>('[data-language-demo]')) mountLanguageDemo(root)
</script>

<style>
  .language-demo {
    margin-block: 1.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    padding: 1rem;
    border-block-end: 1px solid var(--sl-color-hairline);
  }
  label {
    display: grid;
    gap: 0.25rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  select,
  input {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    font: inherit;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    padding: 0.375rem 0.5rem;
  }
  .output {
    padding: 1rem;
    font-size: var(--sl-text-base);
  }
  .output p {
    margin: 0;
    padding-block: 0.125rem;
  }
  .call {
    display: block;
    padding: 0.625rem 1rem;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    border-block-start: 1px solid var(--sl-color-hairline);
    overflow-x: auto;
    white-space: nowrap;
  }
</style>
