---
import { ui } from '../loclizr/groups'
import { languageName } from './language-demo'
import { siteLocales } from './site-language'
---

<label class="site-language">
  <span class="sr-only" data-ui="language">Language</span>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8 6 6"></path><path d="m4 14 6-6 2-3"></path><path d="M2 5h12"></path><path d="M7 2h1"></path><path d="m22 22-5-10-5 10"></path><path d="M14 18h6"></path></svg>
  <select data-site-language title={ui.docsInEnglish({}, { locale: 'en' })}>
    {siteLocales.map((locale) => <option value={locale} lang={locale}>{languageName(locale)}</option>)}
  </select>
</label>

<script>
  import { applySiteLocale, mountSiteLanguage, storedLocale } from './site-language'

  for (const select of document.querySelectorAll<HTMLSelectElement>('[data-site-language]')) mountSiteLanguage(select)
  const locale = storedLocale()
  if (locale !== 'en') applySiteLocale(locale)
</script>

<style>
  .site-language {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    padding-inline: 0.5rem;
    border: 1px solid var(--line);
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
  .site-language:hover,
  .site-language:focus-within {
    color: var(--foreground);
    border-color: color-mix(in oklab, var(--foreground) 30%, var(--background));
  }
  select {
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    max-width: 11rem;
  }
  select:focus-visible {
    outline: none;
  }
  .site-language:has(select:focus-visible) {
    outline: 2px solid var(--foreground);
    outline-offset: 2px;
  }
</style>
